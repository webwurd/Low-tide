<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the same sources Unity compiles (Assets/Scripts/Core) so the game logic can be unit-tested
       from the command line without the Unity editor:  dotnet test unity/dotnet/Tests/LowTide.Core.Tests.csproj -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>LowTide.Core</RootNamespace>
    <AssemblyName>LowTide.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
