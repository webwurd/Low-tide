class_name Interiors extends Node3D
## The three interiors (res://scenes/interiors/, generated by
## tools/build_assets.sh and editable in the editor), placed far from the
## island so they never share space with it. Arthur is teleported between
## rooms behind a short fade. This loader collects interactables by id and
## spawn markers by name, and drives the lamp and the light through windows.

const COTTAGE := Vector3(1000, 0, 0)
const WATCH := Vector3(1000, 0, 100)
const LANTERN := Vector3(1000, 0, 200)
const ROOMS := {
	"res://scenes/interiors/Cottage.tscn": COTTAGE,
	"res://scenes/interiors/WatchRoom.tscn": WATCH,
	"res://scenes/interiors/LanternRoom.tscn": LANTERN,
}

var its: Dictionary = {}               # id -> Interactable
var spawn: Dictionary = {}             # place -> Vector3
var lamp_glow: OmniLight3D
var lamp_mesh: MeshInstance3D
var _lamp_lit_mat: Material
var _lamp_off_mat: Material
var _window_view: ShaderMaterial
var _window_lights: Array[Light3D] = []
var _uni_logs: Node3D

func build() -> void:
	for path in ROOMS:
		var room: Node3D = (load(path) as PackedScene).instantiate()
		room.position = ROOMS[path]
		add_child(room)
		PropLoader.apply_overrides(room)
		for n in room.get_children():
			if n is Interactable:
				its[(n as Interactable).id] = n
			elif n is Marker3D and n.name.begins_with("Spawn_"):
				spawn[n.name.trim_prefix("Spawn_")] = (n as Marker3D).global_position
	var lantern := get_child(2)
	lamp_glow = lantern.get_node("LampGlow")
	lamp_mesh = lantern.get_node("Burner")
	_lamp_lit_mat = load("res://assets/materials/lamp_lit.tres")
	_lamp_off_mat = load("res://assets/materials/lamp_off.tres")
	_window_view = load("res://assets/materials/window_view.tres")
	for n in find_children("*", "Light3D", true, false):
		if n.is_in_group("window_light"):
			_window_lights.append(n)
	_configure_pickups()

## M4-M6 story pickups: when each one can be found (the rules are code, so
## they live here rather than in the scenes; give_item is set in the scene).
func _configure_pickups() -> void:
	its["shelf_logs"].visible_fn = func(): return not GameState.has_item("uni_logs")
	its["floorboard"].visible_fn = func(): return GameClock.day >= 3 and not GameState.has_item("tape_3")
	its["locker"].visible_fn = func(): return GameClock.day >= 4 and not GameState.has_item("tape_4")
	_uni_logs = get_child(0).get_node_or_null("UniLogbooks")

func _process(_delta: float) -> void:
	if _uni_logs:
		_uni_logs.visible = not GameState.has_item("uni_logs")

## Called by Main when the lamp state changes.
func set_lamp(lit: bool) -> void:
	lamp_glow.light_energy = 2.6 if lit else 0.0
	lamp_mesh.material_override = _lamp_lit_mat if lit else _lamp_off_mat

## Window panes show the current sky; daylight spills in through them.
func set_outside(daylight: float, sky_top: Color, sky_horizon: Color, sea: Color) -> void:
	if _window_view:
		_window_view.set_shader_parameter("sky_top", sky_top)
		_window_view.set_shader_parameter("sky_horizon", sky_horizon)
		_window_view.set_shader_parameter("sea", sea)
		_window_view.set_shader_parameter("energy", lerpf(0.35, 1.15, daylight))
	for l in _window_lights:
		l.light_energy = lerpf(0.06, 2.0, daylight)
		l.light_color = sky_horizon.lerp(Color("b9cde0"), 0.5)
