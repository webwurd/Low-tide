class_name Island extends Node3D
## Gannet Rock outdoors: loads the landmark scenes (res://scenes/island/,
## generated by tools/build_assets.sh and editable in the editor), the
## terrain and vegetation, and drives the bits that change at runtime: the
## lamp, the sweeping beam, window glow and the dock light.

const SCENES := [
	"res://scenes/island/Lighthouse.tscn", "res://scenes/island/Cottage.tscn",
	"res://scenes/island/Pier.tscn", "res://scenes/island/Wreck.tscn",
	"res://scenes/island/SeaCave.tscn", "res://scenes/island/Rocks.tscn",
]

var beam_pivot: Node3D
var beam_arms: Array[Node3D] = []
var beam_mat: ShaderMaterial
var beam_spots: Array[SpotLight3D] = []
var lens: MeshInstance3D
var lamp_light: OmniLight3D
var dock_light: OmniLight3D
var beam_spinning := false
var cottage_door: Interactable
var tower_door: Interactable
var spawn_point := Vector3(0.0, Terrain.PIER_TOP + 0.05, 24.0)
var _window_mat: ShaderMaterial
var _lamp_lit_mat: Material
var _lamp_off_mat: Material

func build() -> void:
	_build_terrain()
	for path in SCENES:
		var scene: PackedScene = load(path)
		var inst := scene.instantiate()
		add_child(inst)
		PropLoader.apply_overrides(inst)
	var lh := get_node("Lighthouse")
	beam_pivot = lh.get_node("BeamPivot")
	for arm in beam_pivot.get_children():
		if arm.name.begins_with("Arm"):
			beam_arms.append(arm)
			beam_spots.append(arm.get_node("Spot"))
			beam_mat = (arm.get_node("Shaft") as MeshInstance3D).material_override
	lamp_light = beam_pivot.get_node("LampLight")
	lens = lh.get_node("Lens")
	tower_door = _find_interactable(lh, "lighthouse")
	cottage_door = _find_interactable(get_node("Cottage"), "cottage")
	dock_light = get_node("Pier/DockLight")
	_window_mat = load("res://assets/materials/window_glow.tres")
	_lamp_lit_mat = load("res://assets/materials/lamp_lit.tres")
	_lamp_off_mat = load("res://assets/materials/lamp_off.tres")
	set_lamp(false, false, 1.0)

func _find_interactable(root: Node, id: String) -> Interactable:
	for n in root.get_children():
		if n is Interactable and (n as Interactable).id == id:
			return n
	return null

func _process(delta: float) -> void:
	if beam_pivot and beam_spinning:
		beam_pivot.rotation.y += delta * 0.48

## Window glow + dock lamp follow the light: lamps go on as the day fades.
func set_daylight(daylight: float) -> void:
	var night := 1.0 - daylight
	if _window_mat:
		_window_mat.set_shader_parameter("emission_energy", lerpf(0.25, 2.4, night))
	if dock_light:
		dock_light.light_energy = lerpf(0.0, 1.1, smoothstep(0.3, 0.9, night))

# --- helpers -----------------------------------------------------------

## Where Arthur stands (feet) when he steps out of the cottage door.
func cottage_exit() -> Vector3:
	var local := Vector3(0, 0, 3.8).rotated(Vector3.UP, Terrain.COTTAGE_YAW)
	return Vector3(Terrain.COTTAGE_POS.x + local.x, Terrain.COTTAGE_Y + 0.05, Terrain.COTTAGE_POS.y + local.z)

func tower_exit() -> Vector3:
	return Vector3(0, 10.25, -0.9)

## Lamp lit + weights wound = lens turns and the beam sweeps. `daylight` 0..1
## makes the beam stronger at night.
func set_lamp(lit: bool, wound: bool, daylight: float) -> void:
	beam_spinning = lit and wound
	for a in beam_arms:
		a.visible = lit
	beam_mat.set_shader_parameter("intensity", lerpf(0.32, 0.05, daylight))
	for sp in beam_spots:
		sp.light_energy = lerpf(14.0, 3.0, daylight) if lit else 0.0
	lens.material_override = _lamp_lit_mat if lit else _lamp_off_mat
	lamp_light.light_energy = 2.2 if lit else 0.0
	set_daylight(daylight)

# --- terrain -----------------------------------------------------------

func _build_terrain() -> void:
	var mesh := Terrain.build_mesh()
	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.roughness = 0.88
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	mi.material_override = mat
	add_child(mi)
	var body := StaticBody3D.new()
	var cs := CollisionShape3D.new()
	cs.shape = mesh.create_trimesh_shape()
	body.add_child(cs)
	add_child(body)
