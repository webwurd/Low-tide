; Engine configuration file.
config_version=5

[application]
config/name="Low Tide"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]
Settings="*res://autoload/settings.gd"
GameClock="*res://autoload/game_clock.gd"
TideSystem="*res://autoload/tide_system.gd"
GameState="*res://autoload/game_state.gd"
DayDirector="*res://autoload/day_director.gd"
SaveSystem="*res://autoload/save_system.gd"
RadioSystem="*res://autoload/radio_system.gd"
AudioDirector="*res://autoload/audio_director.gd"
TapePlayer="*res://autoload/tape_player.gd"
ReactiveDirector="*res://autoload/reactive_director.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
environment/defaults/default_clear_color=Color(0.086, 0.125, 0.165, 1)
