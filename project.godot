; Engine configuration file.
config_version=5

[application]
config/name="Low Tide"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]
Settings="*res://autoload/settings.gd"
GameClock="*res://autoload/game_clock.gd"
TideSystem="*res://autoload/tide_system.gd"
GameState="*res://autoload/game_state.gd"
DayDirector="*res://autoload/day_director.gd"
SaveSystem="*res://autoload/save_system.gd"
RadioSystem="*res://autoload/radio_system.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
environment/defaults/default_clear_color=Color(0.086, 0.125, 0.165, 1)
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
environment/ssao/quality=3
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]
sun_dir={
"type": "vec3",
"value": Vector3(0.3, 0.4, 0.8)
}
sun_color={
"type": "color",
"value": Color(1, 0.9, 0.75, 1)
}
shadow_tint={
"type": "color",
"value": Color(0.24, 0.23, 0.36, 1)
}
daylight={
"type": "float",
"value": 1.0
}
wetness={
"type": "float",
"value": 0.0
}
tide_height={
"type": "float",
"value": 2.0
}
wind={
"type": "float",
"value": 0.3
}
fog_tint={
"type": "color",
"value": Color(0.6, 0.66, 0.7, 1)
}
